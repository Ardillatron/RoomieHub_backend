# Variables de entorno del backend. Copia este archivo como .env (ignorado por git) y llena los valores.
# Local: tambien puedes usar local.properties (ver local.properties.example). Docker: docker run --env-file .env
DB_URL=jdbc:postgresql://localhost:5432/roomiehub_dev
DB_USER=app_user
DB_PASSWORD=
DB_OWNER_USER=roomiehub_owner
DB_OWNER_PASSWORD=
# HS256, al menos 32 bytes
JWT_SECRET=
# Client IDs de OAuth de Google separados por comas (opcional)
GOOGLE_CLIENT_IDS=
# Secreto del disparador externo POST /internal/jobs/ejecutar (opcional)
JOBS_SECRET=
# cloudinary://<api_key>:<api_secret>@<cloud_name> (opcional: sin el, las imagenes responden 503)
CLOUDINARY_URL=
# Ruta al JSON de la cuenta de servicio de Firebase (opcional: sin el, las notificaciones van al log)
FIREBASE_CREDENTIALS=
